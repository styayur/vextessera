diff --git a/vendor/glib/src/collections/ptr_slice.rs b/vendor/glib/src/collections/ptr_slice.rs
index e925d98..f462401 100644
--- a/vendor/glib/src/collections/ptr_slice.rs
+++ b/vendor/glib/src/collections/ptr_slice.rs
@@ -895,11 +895,14 @@ impl<T: TransparentPtrType> PtrSlice<T> {
